def test_systemd_not_found_takes_precedence_over_inactive() -> None:
    report = diagnose_incident(
        "Investigate demo-web.service",
        [
            result(
                "get_service_status",
                {
                    "service_name": "demo-web.service",
                    "load_state": "not-found",
                    "active_state": "inactive",
                    "sub_state": "dead",
