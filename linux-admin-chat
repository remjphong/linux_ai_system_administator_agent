#!/usr/bin/env bash
set -u

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CLI="$ROOT/.venv/bin/linux-admin"
CONFIG_DIR="${LINUX_ADMIN_CONFIG_DIR:-/tmp/linux-admin-v1-config}"

if [[ ! -x "$CLI" ]]; then
    CLI="$(command -v linux-admin || true)"
fi

if [[ -z "$CLI" || ! -x "$CLI" ]]; then
    echo "Loi: Khong tim thay lenh linux-admin."
    echo "Hay kich hoat .venv va cai dat project truoc."
    exit 1
fi

if [[ ! -d "$CONFIG_DIR" ]]; then
    echo "Loi: Khong tim thay thu muc cau hinh: $CONFIG_DIR"
    echo "Hay kiem tra LINUX_ADMIN_CONFIG_DIR."
    exit 1
fi

export LLM_ENABLED="${LLM_ENABLED:-false}"
export LLM_PLANNING_MODE="${LLM_PLANNING_MODE:-rules}"
export TAVILY_ENABLED="${TAVILY_ENABLED:-false}"

echo "=========================================="
echo "       Linux AI Administrator"
echo "=========================================="
echo "Nhap yeu cau tu nhien de dieu tra."
echo "Go exit de thoat."
echo "Moi yeu cau se duoc xu ly trong mot luot rieng."
echo

while true; do
    IFS= read -r -p "Ban > " request || {
        echo
        break
    }

    request="${request#"${request%%[![:space:]]*}"}"
    request="${request%"${request##*[![:space:]]}"}"

    [[ -z "$request" ]] && continue

    case "${request,,}" in
        exit|quit|thoat)
            echo "Da thoat Linux AI Administrator."
            break
            ;;
    esac

    echo
    echo "Agent > Dang tiep nhan yeu cau..."
    "$CLI" \
        --config-dir "$CONFIG_DIR" \
        --investigate "$request"

    result=$?
    if (( result != 0 )); then
        echo "Luot dieu tra ket thuc voi ma loi: $result"
    fi
    echo
done
