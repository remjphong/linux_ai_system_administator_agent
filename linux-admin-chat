#!/usr/bin/env bash
set -u

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CLI="$ROOT/.venv/bin/linux-admin"
CONFIG_DIR="${LINUX_ADMIN_CONFIG_DIR:-$ROOT/config}"

if [[ ! -x "$CLI" ]]; then
    CLI="$(command -v linux-admin || true)"
fi

if [[ -z "$CLI" || ! -x "$CLI" ]]; then
    echo "Loi: Khong tim thay lenh linux-admin."
    echo "Hay kich hoat .venv va cai dat project truoc."
    exit 1
fi

if [[ ! -d "$CONFIG_DIR" ]]; then
    echo "Loi: Khong tim thay thu muc cau hinh: $CONFIG_DIR"
    echo "Hay kiem tra LINUX_ADMIN_CONFIG_DIR."
    exit 1
fi

PYTHON="${CLI%/*}/python"
if [[ ! -x "$PYTHON" ]]; then
    PYTHON="$(command -v python3 || true)"
fi
if [[ -z "$PYTHON" || ! -x "$PYTHON" ]]; then
    echo "Loi: Khong tim thay Python de chay giao dien chat."
    exit 1
fi

export LLM_ENABLED="${LLM_ENABLED:-false}"
export LLM_PLANNING_MODE="${LLM_PLANNING_MODE:-rules}"
export TAVILY_ENABLED="${TAVILY_ENABLED:-false}"

exec "$PYTHON" -m linux_admin.chat --cli "$CLI" --config-dir "$CONFIG_DIR"
