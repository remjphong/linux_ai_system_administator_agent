"""Render investigation results in user-friendly and developer sections."""

from __future__ import annotations

import builtins
import json
import re
import sys
from collections.abc import Callable, Mapping
from typing import Any, TextIO


def _as_dict(value: Any) -> dict[str, Any]:
    return dict(value) if isinstance(value, Mapping) else {}


def _find_payload(events: list[str]) -> tuple[int | None, dict[str, Any] | None]:
    """Find the final JSON result printed by the investigation workflow."""
    for index in range(len(events) - 1, -1, -1):
        candidate = events[index].strip()
        if not candidate.startswith("{"):
            continue
        try:
            parsed = json.loads(candidate)
        except (json.JSONDecodeError, TypeError):
            continue
        if isinstance(parsed, dict) and (
            "incident_id" in parsed
            or "remediation" in parsed
            or ("action" in parsed and "verification" in parsed)
        ):
            return index, parsed
    return None, None


def _get_diagnosis(payload: dict[str, Any]) -> str:
    findings = payload.get("findings", [])
    if not isinstance(findings, list):
        return "Agent chưa trả về kết luận chẩn đoán có cấu trúc."

    for finding in findings:
        if isinstance(finding, str) and finding.startswith("Diagnosis:"):
            diagnosis = finding.removeprefix("Diagnosis:").strip()
            if (
                "endpoint_reachable" in diagnosis
                or "endpoint was reachable" in diagnosis.lower()
            ):
                return (
                    "Tại thời điểm kiểm tra, ứng dụng phản hồi HTTP 200. "
                    "Điều này xác nhận endpoint đang truy cập được, "
                    "nhưng không chứng minh mọi chức năng đều bình thường."
                )
            if "endpoint_unreachable" in diagnosis:
                return (
                    "Endpoint không thể kết nối tại thời điểm kiểm tra. "
                    "Chưa thể kết luận chắc chắn nguyên nhân gốc."
                )
            if "service_failed" in diagnosis:
                return "Dịch vụ đang ở trạng thái lỗi theo kết quả kiểm tra."
            return diagnosis

    for finding in findings:
        if isinstance(finding, str) and (
            "failed state" in finding.lower()
            or "unreachable" in finding.lower()
        ):
            return finding

    return "Chưa đủ dữ liệu để đưa ra kết luận chẩn đoán ngắn gọn."



def _get_incident_label(
    payload: dict[str, Any],
    evidence_items: Any,
) -> str:
    """Choose a report label from the request and collected evidence."""
    raw_request = payload.get("request", "")
    request = raw_request.strip() if isinstance(raw_request, str) else ""
    normalized = request.casefold()

    service_match = re.search(
        r"\b[a-zA-Z0-9_.@-]+\.service\b",
        request,
    )
    if service_match:
        return f"Dịch vụ {service_match.group(0)}"

    resource_cues = (
        "cpu", "ram", "memory", "tài nguyên", "tai nguyen",
        "ổ đĩa", "o dia", "disk usage", "top processes",
        "tiến trình", "tien trinh",
    )
    if any(cue in normalized for cue in resource_cues):
        return "Tài nguyên hệ thống"

    system_cues = (
        "tình trạng hệ thống", "tinh trang he thong",
        "kiểm tra tổng thể", "kiem tra tong the",
        "system health", "overall system", "system status",
        "system overview",
    )
    if any(cue in normalized for cue in system_cues):
        return "Tình trạng hệ thống"

    service_cues = (
        "dịch vụ", "dich vu", "service", "systemd",
        "log", "nhật ký", "nhat ky",
    )
    if any(cue in normalized for cue in service_cues):
        return "Dịch vụ và nhật ký hệ thống"

    network_cues = (
        "mạng", "mang", "network", "internet",
        "kết nối", "ket noi", "dns",
    )
    if any(cue in normalized for cue in network_cues):
        return "Kết nối mạng"

    tool_names = set()
    if isinstance(evidence_items, list):
        tool_names = {
            item.get("tool_name")
            for item in evidence_items
            if isinstance(item, Mapping)
            and isinstance(item.get("tool_name"), str)
        }

    if {"check_http_endpoint", "verify_endpoint"} & tool_names:
        return "Endpoint ứng dụng"
    if {
        "get_service_status", "get_service_logs", "get_failed_services"
    } & tool_names:
        return "Dịch vụ và nhật ký hệ thống"
    if "get_network_state" in tool_names:
        return "Trạng thái mạng"
    if {
        "get_system_overview", "get_disk_usage", "list_top_processes"
    } & tool_names:
        return "Tình trạng hệ thống"

    return request[:100] if request else "Yêu cầu điều tra hệ thống"




def _get_system_survey_lines(payload: dict[str, Any]) -> list[str]:
    """Render a concise Vietnamese summary from observed survey evidence."""
    findings = payload.get("findings", [])
    if not isinstance(findings, list) or not any(
        isinstance(item, str)
        and item.startswith("Diagnosis:")
        and "classification=system_survey" in item
        for item in findings
    ):
        return []

    expected_tools = {
        "get_system_overview": "CPU, RAM và swap",
        "get_disk_usage": "dung lượng ổ đĩa",
        "get_network_state": "trạng thái giao diện mạng",
        "get_failed_services": "dịch vụ systemd lỗi",
        "get_recent_errors": "nhật ký lỗi gần đây",
    }
    observed: dict[str, dict[str, Any]] = {}
    seen: set[str] = set()
    failed: list[str] = []

    evidence = payload.get("evidence", [])
    if isinstance(evidence, list):
        for item in evidence:
            if not isinstance(item, Mapping):
                continue
            name = item.get("tool_name")
            if name not in expected_tools:
                continue
            seen.add(name)
            if item.get("ok") is True:
                observed[name] = _as_dict(item.get("data"))
            else:
                status = item.get("status", "unknown")
                failed.append(f"{expected_tools[name]} (status={status})")

    def percentage(data: dict[str, Any], key: str) -> float | None:
        value = data.get(key)
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            return None
        if not 0 <= value <= 100:
            return None
        return float(value)

    lines = ["", "TÓM TẮT BẰNG CHỨNG"]

    system = observed.get("get_system_overview")
    if system is not None:
        metrics = []
        for key, label in (
            ("cpu_percent", "CPU"),
            ("memory_percent", "RAM"),
            ("swap_percent", "swap"),
        ):
            value = percentage(system, key)
            if value is not None:
                metrics.append(f"{label}: {value:.1f}%")
        if metrics:
            lines.append("  Tài nguyên: " + "; ".join(metrics) + ".")

    disk = observed.get("get_disk_usage")
    if disk is not None:
        used = percentage(disk, "used_percent")
        if used is not None:
            path = str(disk.get("path", "filesystem"))
            lines.append(f"  Ổ đĩa {path}: đã sử dụng {used:.1f}%.")

    network = observed.get("get_network_state")
    if network is not None:
        interfaces = network.get("interfaces")
        if isinstance(interfaces, list):
            up = sum(
                isinstance(item, Mapping) and item.get("is_up") is True
                for item in interfaces
            )
            down = sum(
                isinstance(item, Mapping) and item.get("is_up") is False
                for item in interfaces
            )
            lines.append(
                f"  Mạng cục bộ: {len(interfaces)} giao diện được liệt kê; "
                f"{up} up, {down} down."
            )
        else:
            lines.append(
                "  Mạng cục bộ: không có danh sách giao diện hợp lệ."
            )

    services = observed.get("get_failed_services")
    if services is not None:
        names = services.get("failed_services")
        if isinstance(names, list):
            if not names:
                lines.append(
                    "  Dịch vụ systemd: không tìm thấy unit ở trạng thái failed."
                )
            else:
                lines.append(
                    f"  Dịch vụ systemd: có {len(names)} unit ở trạng thái failed."
                )
                lines.extend(f"    - {str(name)[:160]}" for name in names[:5])

    journal = observed.get("get_recent_errors")
    if journal is not None:
        messages = journal.get("errors")
        if isinstance(messages, list):
            window = journal.get("since_minutes", "không rõ")
            if not messages:
                lines.append(
                    "  Nhật ký lỗi gần đây: không có thông điệp mức error "
                    f"trong cửa sổ {window} phút."
                )
            else:
                lines.append(
                    f"  Nhật ký lỗi gần đây: có {len(messages)} thông điệp "
                    f"mức error trong cửa sổ {window} phút."
                )
                for message in messages[:2]:
                    if isinstance(message, str) and message.strip():
                        lines.append(f"    - {message.strip()[:240]}")

    missing = [
        label
        for name, label in expected_tools.items()
        if name not in seen
    ]
    if missing:
        lines.append(
            "  Chưa thu thập được: " + ", ".join(missing) + "."
        )
    if failed:
        lines.append("  Kiểm tra thất bại: " + "; ".join(failed) + ".")

    lines.append(
        "  Giới hạn: một mẫu đo và trạng thái giao diện mạng không xác nhận "
        "toàn bộ sức khỏe ứng dụng hoặc khả năng truy cập Internet."
    )
    return lines

def _render_user_report(
    payload: dict[str, Any] | None,
    exit_code: Any,
) -> str:
    if payload is None:
        return (
            "KHÔNG ĐỌC ĐƯỢC KẾT QUẢ CÓ CẤU TRÚC\n"
            "Không thể tạo báo cáo tóm tắt tự động. "
            "Xem DEVELOPER DETAILS để kiểm tra đầu ra gốc."
        )

    evidence_items = payload.get("evidence", [])
    current_service = {}
    current_endpoint = {}

    if isinstance(evidence_items, list):
        for item in evidence_items:
            if not isinstance(item, Mapping):
                continue
            tool_name = item.get("tool_name")
            data = _as_dict(item.get("data"))
            if tool_name == "get_service_status":
                current_service = data
            elif tool_name in {"check_http_endpoint", "verify_endpoint"}:
                current_endpoint = data

    service_is_active = (
        current_service.get("active_state") == "active"
        or current_service.get("is_active") is True
    )
    endpoint_is_healthy = (
        current_endpoint.get("healthy") is True
        and current_endpoint.get("status_code") == 200
    )
    healthy_without_changes = (
        payload.get("status") == "completed"
        and service_is_active
        and endpoint_is_healthy
    )

    remediation = _as_dict(payload.get("remediation"))
    resolution = _as_dict(remediation.get("problem_resolution"))
    proposal = _as_dict(remediation.get("proposal"))
    action = _as_dict(remediation.get("action"))
    action_data = _as_dict(action.get("data"))
    policy = _as_dict(remediation.get("policy"))
    verification = _as_dict(remediation.get("verification"))
    verification_data = _as_dict(verification.get("data"))
    endpoint = _as_dict(remediation.get("endpoint_verification"))
    endpoint_data = _as_dict(endpoint.get("data"))

    action_executed = action_data.get("executed") is True
    read_only_completed = (
        payload.get("status") == "completed"
        and remediation.get("status") == "not_proposed"
        and remediation.get("changes_made") is not True
        and not action_executed
    )
    approval_rejected = (
        action_data.get("approval_rejected") is True
        or resolution.get("status") == "rejected"
        or remediation.get("status") == "rejected"
    )
    resolved = resolution.get("resolved") is True
    approval_required = policy.get("outcome") == "approval_required"
    service_name = (
        _as_dict(proposal.get("arguments")).get("service_name")
        or action_data.get("service_name")
        or current_service.get("service_name")
        or _get_incident_label(payload, evidence_items)
    )

    process_failed = (
        isinstance(exit_code, int)
        and not isinstance(exit_code, bool)
        and exit_code != 0
    )

    if resolved:
        headline = "DA KHAC PHUC VA XAC MINH"
    elif approval_rejected:
        headline = "CHUA KHAC PHUC - KHONG THUC HIEN THAY DOI"
    elif approval_required and not action:
        headline = "DANG CHO PHE DUYET"
    elif action_executed:
        headline = "DA THUC HIEN HANH DONG - CAN XEM KET QUA XAC MINH"
    elif healthy_without_changes and remediation.get("status") == "not_proposed":
        headline = "TRANG THAI HIEN TAI BINH THUONG - KHONG CAN RESTART"
    elif read_only_completed:
        headline = "DA HOAN TAT KIEM TRA - KHONG THUC HIEN THAY DOI"
    elif payload.get("status") == "failed" or (
        process_failed and payload.get("status") != "completed"
    ):
        headline = "DIEU TRA GAP LOI"
    else:
        headline = "DA DIEU TRA - CHUA XAC NHAN KHAC PHUC"

    lines = [
        headline,
        "-" * 68,
        f"Su co: {service_name}",
        f"Chan doan: {_get_diagnosis(payload)}",
    ]
    lines.extend(_get_system_survey_lines(payload))

    if resolved:
        lines.append(
            "Ket luan: He thong da vuot qua cac buoc xac minh sau khi xu ly."
        )
    elif healthy_without_changes and remediation.get("status") == "not_proposed":
        lines.append(
            "Ket luan: Dich vu dang chay va endpoint tra ve HTTP 200. "
            "Lan kiem tra nay khong tai hien su co, nen agent khong restart "
            "va khong thay doi he thong."
        )
        lines.append(
            f"Trang thai dich vu: {current_service.get('active_state', 'khong ro')}."
        )
        lines.append(
            f"Endpoint: HTTP {current_endpoint.get('status_code')} "
            f"- {current_endpoint.get('url', 'khong co URL')}."
        )
    elif approval_rejected:
        lines.append(
            "Ket luan: Thao tac thay doi he thong da bi tu choi; "
            "agent khong thuc hien thao tac do."
        )
    elif approval_required and not action:
        lines.append(
            "Ket luan: Agent dang de xuat thao tac va can nguoi van hanh "
            "phe duyet truoc khi thuc thi."
        )
    elif action_executed:
        lines.append(
            "Ket luan: Thao tac da duoc thuc hien, nhung chua co du bang chung "
            "de khang dinh su co da duoc khac phuc."
        )
    elif read_only_completed:
        lines.append(
            "Ket luan: Da thu thap bang chung trong pham vi yeu cau; "
            "khong thuc hien thao tac thay doi he thong."
        )
    else:
        lines.append(
            "Ket luan: Chua co du bang chung de khang dinh su co da duoc "
            "khac phuc."
        )

    if proposal:
        lines.append(f"De xuat cua agent: {proposal.get('title', 'Xem chi tiet ky thuat')}")

    if action_executed:
        action_name = action.get("tool_name", proposal.get("action_name", ""))
        lines.append(f"Thao tac da thuc hien: {action_name or 'Thao tac co thay doi he thong'}")
    elif approval_rejected:
        lines.append("Thao tac thay doi he thong: KHONG duoc thuc hien")
    elif proposal:
        lines.append("Thao tac thay doi he thong: CHUA duoc xac nhan la da thuc hien")

    if verification_data:
        service_healthy = verification_data.get("healthy")
        service_state = verification_data.get("active_state", "khong ro")
        if service_healthy is True:
            lines.append(f"Xac minh dich vu: DAT ({service_state})")
        elif service_healthy is False:
            lines.append(f"Xac minh dich vu: KHONG DAT ({service_state})")
        else:
            lines.append("Xac minh dich vu: Chua co ket luan ro rang")

    if endpoint_data:
        code = endpoint_data.get("status_code")
        endpoint_healthy = endpoint_data.get("healthy")
        url = endpoint_data.get("url", "endpoint ban dau")
        if endpoint_healthy is True:
            lines.append(f"Xac minh ung dung: DAT - HTTP {code} - {url}")
        elif endpoint_healthy is False:
            lines.append(f"Xac minh ung dung: KHONG DAT - {url}")
        else:
            lines.append(f"Xac minh ung dung: Chua ro - {url}")

    if resolved:
        lines.append(
            "Luu y: Ket qua chi xac nhan cac buoc kiem tra da thuc hien, "
            "khong bao dam moi chuc nang cua ung dung deu hoat dong."
        )
    elif approval_rejected:
        lines.append(
            "Buoc tiep theo: Neu muon tiep tuc, doc de xuat va rui ro, "
            "sau do chay lai va tu phe duyet khi da chac chan."
        )
    elif read_only_completed:
        next_step = remediation.get("recommended_next_step")
        if isinstance(next_step, str) and next_step.strip():
            lines.append(f"Buoc tiep theo: {next_step.strip()}")
    elif not action_executed:
        lines.append(
            "Buoc tiep theo: Xem phan DEVELOPER DETAILS de biet bang chung "
            "va hanh dong duoc de xuat."
        )

    lines.append(f"Incident ID: {payload.get('incident_id', 'khong co')}")
    return "\n".join(lines)


def _payload_from_result(value: Any) -> dict[str, Any] | None:
    """Extract a JSON-compatible mapping from a workflow return value."""
    if isinstance(value, Mapping):
        return dict(value)

    if isinstance(value, (tuple, list)):
        for item in reversed(value):
            payload = _payload_from_result(item)
            if payload is not None:
                return payload

    converter = getattr(value, "to_dict", None)
    if callable(converter):
        try:
            converted = converter()
        except (TypeError, ValueError):
            return None
        if isinstance(converted, Mapping):
            return dict(converted)

    return None


def run_with_dual_report(
    operation: Callable[..., Any],
    *args: Any,
    **kwargs: Any,
) -> Any:
    """Capture normal print output but preserve interactive approval prompts."""
    real_print = builtins.print
    real_input = builtins.input
    events: list[str] = []
    replayed: set[int] = set()
    caught_error: BaseException | None = None
    result: Any = None

    def capture_print(
        *objects: Any,
        sep: str = " ",
        end: str = "\n",
        file: TextIO | None = None,
        flush: bool = False,
    ) -> None:
        if file is not None and file is not sys.stdout:
            real_print(*objects, sep=sep, end=end, file=file, flush=flush)
            return
        events.append(sep.join(str(obj) for obj in objects) + end)

    def approval_input(prompt: str = "") -> str:
        marker = "ACTION APPROVAL REQUIRED"
        start = next(
            (
                index
                for index in range(len(events) - 1, -1, -1)
                if marker in events[index]
            ),
            None,
        )
        # Never hide the action, arguments, reason, or approval context.
        if start is not None:
            for index in range(start, len(events)):
                if index not in replayed:
                    real_print(events[index], end="")
                    replayed.add(index)
        return real_input(prompt)

    try:
        builtins.print = capture_print
        builtins.input = approval_input
        result = operation(*args, **kwargs)
    except BaseException as exc:  # noqa: BLE001
        caught_error = exc
    finally:
        builtins.print = real_print
        builtins.input = real_input

    payload_index, payload = _find_payload(events)
    if payload is None:
        payload = _payload_from_result(result)

    # Preserve JSON-only stdout for tests, pipes, and integrations.
    # Interactive terminals receive the two-section human-readable report.
    try:
        interactive_terminal = (
            sys.stdout.isatty()
            or __import__("os").environ.get("LINUX_ADMIN_REPORT", "").lower()
            == "text"
        )
    except (AttributeError, OSError):
        interactive_terminal = False

    if not interactive_terminal:
        # main() owns the final JSON print. Never print a second document here.
        if caught_error is not None:
            raise caught_error
        return result

    real_print()
    real_print("=" * 78)
    real_print("[1] USER REPORT - BAO CAO CHO NGUOI VAN HANH")
    real_print("=" * 78)
    real_print(_render_user_report(payload, result))

    real_print()
    real_print("=" * 78)
    real_print("[2] DEVELOPER DETAILS - CHI TIET KY THUAT")
    real_print("=" * 78)

    detail_events = [
        event for index, event in enumerate(events) if index != payload_index
    ]
    if detail_events:
        real_print("--- Nhat ky va dau ra chi tiet ---")
        for event in detail_events:
            real_print(event, end="")
    else:
        real_print(
            "Khong co log text rieng duoc capture. "
            "Du lieu ky thuat day du se duoc CLI in trong JSON ben duoi."
        )

    real_print()
    real_print("JSON chi tiet se duoc CLI in mot lan ben duoi.")

    if caught_error is not None:
        raise caught_error

    return result
