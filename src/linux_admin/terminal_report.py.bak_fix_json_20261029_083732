"""Render investigation results in user-friendly and developer sections."""

from __future__ import annotations

import builtins
import json
import sys
from collections.abc import Callable, Mapping
from typing import Any, TextIO


def _as_dict(value: Any) -> dict[str, Any]:
    return dict(value) if isinstance(value, Mapping) else {}


def _find_payload(events: list[str]) -> tuple[int | None, dict[str, Any] | None]:
    """Find the final JSON result printed by the investigation workflow."""
    for index in range(len(events) - 1, -1, -1):
        candidate = events[index].strip()
        if not candidate.startswith("{"):
            continue
        try:
            parsed = json.loads(candidate)
        except (json.JSONDecodeError, TypeError):
            continue
        if isinstance(parsed, dict) and (
            "incident_id" in parsed
            or "remediation" in parsed
            or ("action" in parsed and "verification" in parsed)
        ):
            return index, parsed
    return None, None


def _get_diagnosis(payload: dict[str, Any]) -> str:
    findings = payload.get("findings", [])
    if not isinstance(findings, list):
        return "Agent chưa trả về kết luận chẩn đoán có cấu trúc."

    for finding in findings:
        if isinstance(finding, str) and finding.startswith("Diagnosis:"):
            diagnosis = finding.removeprefix("Diagnosis:").strip()
            if "endpoint_unreachable" in diagnosis:
                return (
                    "Endpoint không thể kết nối tại thời điểm kiểm tra. "
                    "Chưa thể kết luận chắc chắn nguyên nhân gốc."
                )
            if "service_failed" in diagnosis:
                return "Dịch vụ đang ở trạng thái lỗi theo kết quả kiểm tra."
            return diagnosis

    for finding in findings:
        if isinstance(finding, str) and (
            "failed state" in finding.lower()
            or "unreachable" in finding.lower()
        ):
            return finding

    return "Chưa đủ dữ liệu để đưa ra kết luận chẩn đoán ngắn gọn."


def _render_user_report(
    payload: dict[str, Any] | None,
    exit_code: Any,
) -> str:
    if payload is None:
        return (
            "KHÔNG ĐỌC ĐƯỢC KẾT QUẢ CÓ CẤU TRÚC\n"
            "Không thể tạo báo cáo tóm tắt tự động. "
            "Xem DEVELOPER DETAILS để kiểm tra đầu ra gốc."
        )

    remediation = _as_dict(payload.get("remediation"))
    resolution = _as_dict(remediation.get("problem_resolution"))
    proposal = _as_dict(remediation.get("proposal"))
    action = _as_dict(remediation.get("action"))
    action_data = _as_dict(action.get("data"))
    policy = _as_dict(remediation.get("policy"))
    verification = _as_dict(remediation.get("verification"))
    verification_data = _as_dict(verification.get("data"))
    endpoint = _as_dict(remediation.get("endpoint_verification"))
    endpoint_data = _as_dict(endpoint.get("data"))

    action_executed = action_data.get("executed") is True
    approval_rejected = (
        action_data.get("approval_rejected") is True
        or resolution.get("status") == "rejected"
        or remediation.get("status") == "rejected"
    )
    resolved = resolution.get("resolved") is True
    approval_required = policy.get("outcome") == "approval_required"
    service_name = (
        _as_dict(proposal.get("arguments")).get("service_name")
        or action_data.get("service_name")
        or "Dịch vụ đang được kiểm tra"
    )

    if resolved:
        headline = "DA KHAC PHUC VA XAC MINH"
    elif approval_rejected:
        headline = "CHUA KHAC PHUC - KHONG THUC HIEN THAY DOI"
    elif approval_required and not action:
        headline = "DANG CHO PHE DUYET"
    elif action_executed:
        headline = "DA THUC HIEN HANH DONG - CAN XEM KET QUA XAC MINH"
    elif payload.get("status") == "failed" or exit_code not in (0, None):
        headline = "DIEU TRA GAP LOI"
    else:
        headline = "DA DIEU TRA - CHUA XAC NHAN KHAC PHUC"

    lines = [
        headline,
        "-" * 68,
        f"Su co: {service_name}",
        f"Chan doan: {_get_diagnosis(payload)}",
    ]

    if resolved:
        lines.append(
            "Ket luan: He thong da vuot qua cac buoc xac minh sau khi xu ly."
        )
    elif approval_rejected:
        lines.append(
            "Ket luan: Thao tac thay doi he thong da bi tu choi; "
            "agent khong thuc hien thao tac do."
        )
    elif approval_required and not action:
        lines.append(
            "Ket luan: Agent dang de xuat thao tac va can nguoi van hanh "
            "phe duyet truoc khi thuc thi."
        )
    elif action_executed:
        lines.append(
            "Ket luan: Thao tac da duoc thuc hien, nhung chua co du bang chung "
            "de khang dinh su co da duoc khac phuc."
        )
    else:
        lines.append(
            "Ket luan: Chua co du bang chung de khang dinh su co da duoc "
            "khac phuc."
        )

    if proposal:
        lines.append(f"De xuat cua agent: {proposal.get('title', 'Xem chi tiet ky thuat')}")

    if action_executed:
        action_name = action.get("tool_name", proposal.get("action_name", ""))
        lines.append(f"Thao tac da thuc hien: {action_name or 'Thao tac co thay doi he thong'}")
    elif approval_rejected:
        lines.append("Thao tac thay doi he thong: KHONG duoc thuc hien")
    elif proposal:
        lines.append("Thao tac thay doi he thong: CHUA duoc xac nhan la da thuc hien")

    if verification_data:
        service_healthy = verification_data.get("healthy")
        service_state = verification_data.get("active_state", "khong ro")
        if service_healthy is True:
            lines.append(f"Xac minh dich vu: DAT ({service_state})")
        elif service_healthy is False:
            lines.append(f"Xac minh dich vu: KHONG DAT ({service_state})")
        else:
            lines.append("Xac minh dich vu: Chua co ket luan ro rang")

    if endpoint_data:
        code = endpoint_data.get("status_code")
        endpoint_healthy = endpoint_data.get("healthy")
        url = endpoint_data.get("url", "endpoint ban dau")
        if endpoint_healthy is True:
            lines.append(f"Xac minh ung dung: DAT - HTTP {code} - {url}")
        elif endpoint_healthy is False:
            lines.append(f"Xac minh ung dung: KHONG DAT - {url}")
        else:
            lines.append(f"Xac minh ung dung: Chua ro - {url}")

    if resolved:
        lines.append(
            "Luu y: Ket qua chi xac nhan cac buoc kiem tra da thuc hien, "
            "khong bao dam moi chuc nang cua ung dung deu hoat dong."
        )
    elif approval_rejected:
        lines.append(
            "Buoc tiep theo: Neu muon tiep tuc, doc de xuat va rui ro, "
            "sau do chay lai va tu phe duyet khi da chac chan."
        )
    elif not action_executed:
        lines.append(
            "Buoc tiep theo: Xem phan DEVELOPER DETAILS de biet bang chung "
            "va hanh dong duoc de xuat."
        )

    lines.append(f"Incident ID: {payload.get('incident_id', 'khong co')}")
    return "\n".join(lines)


def run_with_dual_report(
    operation: Callable[..., Any],
    *args: Any,
    **kwargs: Any,
) -> Any:
    """Capture normal print output but preserve interactive approval prompts."""
    real_print = builtins.print
    real_input = builtins.input
    events: list[str] = []
    replayed: set[int] = set()
    caught_error: BaseException | None = None
    result: Any = None

    def capture_print(
        *objects: Any,
        sep: str = " ",
        end: str = "\n",
        file: TextIO | None = None,
        flush: bool = False,
    ) -> None:
        if file is not None and file is not sys.stdout:
            real_print(*objects, sep=sep, end=end, file=file, flush=flush)
            return
        events.append(sep.join(str(obj) for obj in objects) + end)

    def approval_input(prompt: str = "") -> str:
        marker = "ACTION APPROVAL REQUIRED"
        start = next(
            (
                index
                for index in range(len(events) - 1, -1, -1)
                if marker in events[index]
            ),
            None,
        )
        # Never hide the action, arguments, reason, or approval context.
        if start is not None:
            for index in range(start, len(events)):
                if index not in replayed:
                    real_print(events[index], end="")
                    replayed.add(index)
        return real_input(prompt)

    try:
        builtins.print = capture_print
        builtins.input = approval_input
        result = operation(*args, **kwargs)
    except BaseException as exc:  # noqa: BLE001
        caught_error = exc
    finally:
        builtins.print = real_print
        builtins.input = real_input

    payload_index, payload = _find_payload(events)

    # Preserve JSON-only stdout for tests, pipes, and integrations.
    # Interactive terminals receive the two-section human-readable report.
    try:
        interactive_terminal = (
            sys.stdout.isatty()
            or __import__("os").environ.get("LINUX_ADMIN_REPORT", "").lower()
            == "text"
        )
    except (AttributeError, OSError):
        interactive_terminal = False

    if not interactive_terminal:
        if payload is not None:
            real_print(json.dumps(payload, ensure_ascii=False, indent=2))
        else:
            real_print(json.dumps({
                "error": "No structured investigation result was emitted",
                "details": [
                    event.rstrip("\\n")
                    for event in events
                    if event.strip()
                ],
            }, ensure_ascii=False, indent=2))

        if caught_error is not None:
            raise caught_error
        return result

    real_print()
    real_print("=" * 78)
    real_print("[1] USER REPORT - BAO CAO CHO NGUOI VAN HANH")
    real_print("=" * 78)
    real_print(_render_user_report(payload, result))

    real_print()
    real_print("=" * 78)
    real_print("[2] DEVELOPER DETAILS - CHI TIET KY THUAT")
    real_print("=" * 78)

    detail_events = [
        event for index, event in enumerate(events) if index != payload_index
    ]
    if detail_events:
        real_print("--- Nhat ky va dau ra chi tiet ---")
        for event in detail_events:
            real_print(event, end="")
    else:
        real_print("Khong co dau ra chi tiet duoc ghi nhan.")

    if payload is not None:
        real_print()
        real_print("--- Ket qua co cau truc (JSON) ---")
        real_print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        real_print()
        real_print("Khong tim thay JSON ket qua trong dau ra cua investigation.")

    if caught_error is not None:
        raise caught_error

    return result
