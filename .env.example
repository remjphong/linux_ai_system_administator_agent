# Copy this file to .env. Never commit .env or share real API keys in chat.
# Blank toggles do not override config/agent.yaml; use true/false only if needed.

# --- LLM provider key: needed for AI planning and evidence analysis ---
# NOT a Tavily key. Use an OpenAI-compatible /chat/completions endpoint.
LLM_ENABLED=
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# --- Tavily web-search key: optional, separate from the LLM provider ---
# Paste Tavily's key value after '='. Keep this file empty and private in .env.
TAVILY_ENABLED=
TAVILY_API_KEY=

# Optional Groq primary. LLM_* settings above remain the fallback.
# GROQ_MODEL=
# GROQ_API_KEY=
